{
  "name": "itmosoft/laravel-search",
  "description": "Database-backed model search indexing and querying for Laravel applications.",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.3", "illuminate/database": "^12.0 || ^13.0", "illuminate/support": "^12.0 || ^13.0"},
  "require-dev": {"orchestra/testbench": "^10.0 || ^11.0", "phpunit/phpunit": "^11.0 || ^12.0"},
  "autoload": {"psr-4": {"ItmoSoft\\Search\\": "src/"}},
  "autoload-dev": {"psr-4": {"ItmoSoft\\Search\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["ItmoSoft\\Search\\SearchServiceProvider"]}},
  "scripts": {"test": "phpunit", "test:unit": "phpunit --testsuite=Unit", "test:feature": "phpunit --testsuite=Feature"},
  "config": {"sort-packages": true},
  "minimum-stability": "stable",
  "prefer-stable": true
}